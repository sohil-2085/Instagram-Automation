# Unipile API Configuration
# Add these environment variables in your Vercel Project Settings -> Environment Variables

# Unipile DSN (Hostname and port, e.g. api71.unipile.com:20132 or api.unipile.com)
UNIPILE_DSN=api71.unipile.com:20132

# Unipile Access API Key
UNIPILE_API_KEY=your_unipile_api_key_here

# Connected Instagram Account ID
UNIPILE_ACCOUNT_ID=your_connected_instagram_account_id
